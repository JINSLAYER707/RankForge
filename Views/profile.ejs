<link rel="stylesheet" href="/css/style.css">

<div class="profile-wrapper">

<a href="/home" class="back-link">← Back</a>

<!-- PROFILE HEADER -->

<div class="profile-header-card">

<div class="avatar">
    <%= user.name.charAt(0).toUpperCase() %>
</div>

<div class="profile-info">
    <h2><%= user.name %></h2>
    <p><%= user.email %></p>

    <div class="points-badge">
        ⭐ <%= user.points %> pts
    </div>
</div>

</div>

<!-- STATS -->

<div class="stats-row">

<div class="stat-card">
    <div class="stat-number"><%= user.hostedContests.length %></div>
    <div class="stat-label">Contests Hosted</div>
</div>

<div class="stat-card">
    <div class="stat-number"><%= user.participatedContests.length %></div>
    <div class="stat-label">Participated</div>
</div>

</div>

<!-- SOCIAL -->

<div class="social-card">

<h3>Profile</h3>

<div class="social-tabs">

<button class="social-tab active" onclick="showSocialTab('friends',this)">
Friends (<%= user.friends.length %>)
</button>

<button class="social-tab" onclick="showSocialTab('hosted',this)">
Hosted Contests (<%= user.hostedContests.length %>)
</button>

<button class="social-tab" onclick="showSocialTab('participated',this)">
Participated (<%= user.participatedContests.length %>)
</button>

</div>

<!-- FRIENDS -->

<div id="friends" class="social-content active">

<% if(user.friends.length === 0){ %>
<p>No friends yet.</p>
<% } %>

<% user.friends.forEach(friend => { %>

<a href="/profile/<%= friend._id %>" class="user-row">

<div class="avatar-small">
<%= friend.name.charAt(0).toUpperCase() %>
</div>

<span><%= friend.name %></span>

</a>

<% }) %>

</div>

<!-- HOSTED CONTESTS -->

<div id="hosted" class="social-content">

<% if(user.hostedContests.length === 0){ %>
<p>No hosted contests yet.</p>
<% } %>

<% user.hostedContests.forEach(contest => { %>

<a href="/contest/<%= contest._id %>" class="contest-row">

<div class="contest-info">
<h4><%= contest.name %></h4>
<p>Category: <%= contest.category %></p>
</div>

<div class="contest-arrow">→</div>

</a>

<% }) %>

</div>

<!-- PARTICIPATED CONTESTS -->

<div id="participated" class="social-content">

<% if(user.participatedContests.length === 0){ %>
<p>No participated contests yet.</p>
<% } %>

<% user.participatedContests.forEach(contest => { %>

<a href="/contest/<%= contest._id %>" class="contest-row">

<div class="contest-info">
<h4><%= contest.name %></h4>
<p>Category: <%= contest.category %></p>
</div>

<div class="contest-arrow">→</div>

</a>

<% }) %>

</div>

</div>

</div>

<script>

function showSocialTab(id,btn){

document.querySelectorAll(".social-content")
.forEach(el=>el.classList.remove("active"))

document.querySelectorAll(".social-tab")
.forEach(el=>el.classList.remove("active"))

document.getElementById(id).classList.add("active")
btn.classList.add("active")

}

</script>